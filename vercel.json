{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "env": {
    "SERVER_PRESET": "vercel"
  },
  "functions": {
    "api/**/*.ts": {
      "runtime": "nodejs20.x"
    }
  },
  "rewrites": [
    {
      "source": "^/api(/.*)?$",
      "destination": "/api/$1"
    },
    {
      "source": "^(?!/api).*$",
      "destination": "/api/index"
    }
  ]
}
