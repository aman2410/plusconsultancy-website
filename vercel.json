{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "env": {
    "SERVER_PRESET": "vercel"
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
